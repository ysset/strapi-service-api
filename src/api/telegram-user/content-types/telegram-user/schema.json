{
  "kind": "collectionType",
  "collectionName": "telegram_users",
  "info": {
    "singularName": "telegram-user",
    "pluralName": "telegram-users",
    "displayName": "Telegram пользователи",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "telegramId": {
      "type": "integer",
      "required": true
    },
    "isBot": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "adminUser": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "admin::user"
    },
    "invoices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice.invoice",
      "mappedBy": "telegramUser"
    }
  }
}
